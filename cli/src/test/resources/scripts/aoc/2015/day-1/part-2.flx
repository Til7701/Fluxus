import fluxus.flumen.System;
import fluxus.flumen.Str;

let input = "()())))))";

let i = new 0U31;
let floor = new 0I32;

when floor < 0I32 {
    System.println((i + 1U31) as Str);
    i = input.length();
}

do when i < input.length() {
    let char = input[i];
    do when char == '(' {
        floor = floor + 1I32;
    }
    do when char == ')' {
        floor = floor - 1I32;
    }
    i = i + 1U31;
}
