import fluxus.flumen.System;
import fluxus.flumen.Str;

let input = ")())())";

let i = new 0U31;
let floor = new 0I32;
do when i < input.length() {
    let char = input[i];
    do when char == '(' {
        floor = floor + 1I32;
    }
    do when char == ')' {
        floor = floor - 1I32;
    }
    i = i + 1U31;
}

System.println(floor as Str);
