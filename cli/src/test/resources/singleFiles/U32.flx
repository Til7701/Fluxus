import fluxus.flumen.System;
import fluxus.flumen.Str;

let a = new 1U32;
let b = 2U32;

System.println(a as Str);
System.println(b as Str);

let sum = a + b;
System.println(sum as Str);

let difference = b - a;
System.println(difference as Str);

a = 5U32;
System.println(a as Str);

5U32 = new 42U32;
System.println(5U32 as Str);
System.println(a as Str);

let x = 14U32;
System.println(x as Str);

x = new 38U32;
System.println(14U32 as Str);
System.println(x as Str);
