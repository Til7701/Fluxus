import fluxus.flumen.System;
import fluxus.flumen.Str;

let a = "a";
let b = "b";

System.println(a);
System.println(b);
System.println(a + b);

System.println(a == a);
System.println(a == b);
System.println("ab" == "a");

let str = "a,b,c";
let split = str.split(',');
let i = new 0U31;
do when i < split.length() {
    System.println(split[i]);
    i = i + 1U31;
}
