class;

Char[U31] chars = ['0'];

(Char[U31] chars) {
    this.chars = chars;
}

U31 length() {
    return this.chars.length();
}

static Char index(Str str, U31 i) {
    return str.chars[i];
}

static Str add(Str left, Str right) {
    let length = left.length() + (right.length());
    let chars = ['0'; length];
    let resultI = new 0U31;

    let leftI = new 0U31;
    do when leftI < left.length() {
        chars[resultI] = left[leftI];
        resultI = resultI + 1U31;
        leftI = leftI + 1U31;
    }

    let rightI = new 0U31;
    do when rightI < right.length() {
        chars[resultI] = right[rightI];
        resultI = resultI + 1U31;
        rightI = rightI + 1U31;
    }

    return Str(chars);
}

static Str eq(Str left, Str right) {
    do when left.length() != right.length() {
        return false;
    }
    let i = new 0U31;
    do when i < left.length() {
        let tmpI = new i;
        do when left[tmpI] != (right[tmpI]) {
            return false;
        }
        i = i + 1U31;
    }
    return true;
}

Bool isBlank() {
    let i = new 0U31;
    do when i < this.length() {
        let tmpI = new i;
        do when !(this[tmpI].isBlank()) {
            return false;
        }
        i = i + 1U31;
    }
    return true;
}

U32 count(Char c) {
    let count = new 0U32;
    let i = new 0U31;
    do when i < this.length() {
        let tmpI = new i;
        do when this[tmpI] == c {
            count = count + 1U32;
        }
        i = i + 1U31;
    }
    return count;
}

Str[U31] split(Char pattern) {
    let elementCount = this.count(pattern) + 1U31;
    let split = [""; elementCount as U31];

    let thisI = new 0U31;
    let splitI = new 0U31;
    do when thisI < this.length() {
        let char = this[thisI];
        do when char == pattern {
            splitI = splitI + 1U31;
        }
        do when char != pattern {
            split[splitI] = split[splitI] + (this[thisI] as Str);
        }
        thisI = thisI + 1U31;
    }
    return split;
}

I64 parseI64() {
    do when this.length() == 0U31 {
        Native.panic();
    }

    let positive = new true;
    do when this[0U31] == '-' {
        positive = new false;
    }

    let i = new 0U31;
    do when !positive {
        i = i + 1U31;
    }

    let value = new 0I64;
    do when i < this.length() {
        let char = this[i];
        do when !(char.isDigit()) {
            Native.panic();
        }
        let digit = char.asDigit() as I64;
        value = value * 10I64;
        value = value + digit;

        i = i + 1U31;
    }

    do when !positive {
        return 0I64 - value;
    }
    return value;
}
